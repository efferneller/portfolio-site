# The publisher updates only this managed block in the remote .htaccess.
# Other hosting rules, including SSL redirects, are preserved.
# BEGIN portfolio cache
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.[0-9a-f]{12}\.(webp|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
# END portfolio cache
